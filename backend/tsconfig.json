{
    "compilerOptions": {
        "target": "ES6",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "allowJs": false,
        "strict": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
