{
  "name": "developstoday-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm install && npm run install-front && npm run install-back",
    "install-front": "cd frontend && npm install",
    "install-back": "cd backend && npm install",
    "dev:back": "cd backend && npm run dev",
    "dev:front": "cd frontend && npm run dev",
    "build:back": "cd backend && npm run build",
    "build:front": "cd frontend && npm run build",
    "start:back": "cd backend && npm start",
    "start:front": "cd frontend && npm start"
  }
}